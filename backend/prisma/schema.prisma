generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Region {
  INDIA
  INTERNATIONAL
}

enum TourCategory {
  DOMESTIC
  INTERNATIONAL
  HONEYMOON
  FAMILY
  ADVENTURE
  LUXURY
  WEEKEND
  GROUP
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum TripType {
  FAMILY
  HONEYMOON
  ADVENTURE
  LUXURY
  SOLO
  GROUP
  BUSINESS
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  password  String
  role      Role     @default(USER)
  bookings  Booking[]
  reviews   Review[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Destination {
  id             String   @id @default(uuid())
  name           String
  region         Region
  tagline        String?
  description    String?
  image          String
  startingPrice  Decimal?
  isPopular      Boolean  @default(false)
  tours          TourPackage[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([region])
}

model TourPackage {
  id            String        @id @default(uuid())
  title         String
  slug          String        @unique
  category      TourCategory
  destinationId String?
  destination   Destination?  @relation(fields: [destinationId], references: [id])
  destinationLabel String
  duration      String
  rating        Float         @default(4.5)
  price         Decimal
  image         String
  description   String
  inclusions    String[]
  exclusions    String[]
  itinerary     TourItinerary[]
  bookings      Booking[]
  reviews       Review[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([category])
}

model TourItinerary {
  id        String      @id @default(uuid())
  tourId    String
  tour      TourPackage @relation(fields: [tourId], references: [id], onDelete: Cascade)
  day       Int
  title     String
  description String

  @@index([tourId])
}

model Booking {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  tourId       String
  tour         TourPackage   @relation(fields: [tourId], references: [id])
  travelDate   DateTime
  travelers    Int
  totalPrice   Decimal
  status       BookingStatus @default(PENDING)
  contactName  String
  contactEmail String
  contactPhone String
  bookingTravelers BookingTraveler[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
  @@index([tourId])
  @@index([status])
}

model BookingTraveler {
  id        String  @id @default(uuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fullName  String
  age       Int?
  gender    String?

  @@index([bookingId])
}

model Hotel {
  id        String   @id @default(uuid())
  name      String
  city      String
  address   String?
  image     String?
  pricePerNight Decimal?
  rating    Float?
  bookings  HotelBooking[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
}

model HotelBooking {
  id        String   @id @default(uuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  checkIn   DateTime
  checkOut  DateTime
  guests    Int
  guestName String
  guestEmail String
  createdAt DateTime @default(now())

  @@index([hotelId])
}

model FlightSearch {
  id          String   @id @default(uuid())
  fromCity    String
  toCity      String
  departure   DateTime
  passengers  Int
  searchedByEmail String?
  createdAt   DateTime @default(now())
}

model CustomTripRequest {
  id           String   @id @default(uuid())
  fullName     String
  email        String
  phone        String
  destination  String
  travelDate   DateTime
  travelers    Int
  budget       Decimal
  tripType     TripType
  requirements String?
  status       BookingStatus @default(PENDING)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Review {
  id        String      @id @default(uuid())
  tourId    String
  tour      TourPackage @relation(fields: [tourId], references: [id])
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime    @default(now())

  @@index([tourId])
}

model Contact {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())
}
